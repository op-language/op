//! NES Demo Game
//!
//! This file demonstrates the HLA language as specified in
//! docs/language-specification.md. It targets the NTSC NES
//! (mos6502-nintendo-nes-ntsc).
//!
//! Build with:
//!   hlalex --target mos6502-nintendo-nes-ntsc nes-game.hla | \
//!   hlaparse --target mos6502-nintendo-nes-ntsc | \
//!   hlacc --target mos6502-nintendo-nes-ntsc -O1 | \
//!   hlalink --target mos6502-nintendo-nes-ntsc --format ines -o nes.nes

mod nes_std;
mod nes_code;

use nes_std::*;
use nes_code::*;

// --- iNES header -----------------------------------------------------------

#[ines(
    mapper = 0,
    mirroring = "vertical",
    battery = false,
    trainer = false,
    fourscreen = false,
)]

// --- RAM variables ---------------------------------------------------------

#[ram(org = 0x0000, maxsize = 0x100)] {
    counter: u8;
    palcol: u8;
    paddr: pointer;
    pstr: pointer;
    msgbuf: [u8; 64];
    scroll: SCROLL;
    oam: OAM_BUFFER;
}

// --- ROM: main code bank ---------------------------------------------------

#[rom(org = 0xC000, bank = 0, maxsize = 0x4000)] {

    #[interrupt(reset)]
    noreturn fn main() {
        rts
    }

    #[interrupt(nmi)]
    fn nmi_handler() {
        rti
    }

    #[interrupt(irq)]
    fn irq_handler() {
        rti
    }
}

// --- CHR data (pattern tables) ---------------------------------------------

#[chr(bank = 0)] {
    font_load!("font.chr")
}

// --- filler/padding --------------------------------------------------------

#[setpad(0xFF)]
