//! mos6502-nec-pcengine example
//!
//! Minimal cart with reset, NMI, and IRQ handlers.

use std::cpu::*;
use std::machine::*;

#[interrupt(reset)]
noreturn fn main() {
    loop {
    }
}

#[interrupt(nmi)]
fn nmi() {
    rti
}

#[interrupt(irq)]
fn irq() {
    rti
}

#[ram(org = 0x0000, maxsize = 0x100)] {
}

#[rom(org = 0xC000, bank = 0, maxsize = 0x4000)] {
}

#[setpad(0xFF)]