//! NES Demo Game
//!
//! This file demonstrates the Op language as specified in
//! docs/language-specification.md. It targets the NTSC NES
//! (mos6502-nintendo-nes-ntsc).
//!
//! Build with:
//!   opc --target mos6502-nintendo-nes-ntsc --format ines -o nes.nes nes-game.op
//!
//! This example uses the `std` lib. The `std::cpu` module provides
//! CPU register references, opcodes, and condition keywords. The
//! `std::machine` module provides the NES platform constants, types,
//! and inline macros.

mod nes_code;

use std::cpu::*;
use std::machine::*;
use nes_code::*;

// --- iNES header -----------------------------------------------------------

#[ines(
    mapper = 0,
    mirroring = "vertical",
    battery = false,
    trainer = false,
    fourscreen = false,
)]

// --- RAM variables ---------------------------------------------------------

#[ram(org = 0x0000, maxsize = 0x100)] {
    counter: u8;
    palcol: u8;
    paddr: pointer;
    pstr: pointer;
    msgbuf: [u8; 64];
    scroll: SCROLL;
    oam: OAM_BUFFER;
}

// --- ROM: main code bank ---------------------------------------------------

#[rom(org = 0xC000, bank = 0, maxsize = 0x4000)] {

    #[interrupt(reset)]
    locate_fn!(nes_code::main);

    #[interrupt(nmi)]
    locate_fn!(nes_code::nmi_handler);

    #[interrupt(irq)]
    locate_fn!(nes_code::irq_handler);
}

// --- CHR data (pattern tables) ---------------------------------------------

#[chr(bank = 0)] {
    locate_bytes!("font.chr")
}

// --- filler/padding --------------------------------------------------------

#[setpad(0xFF)]
