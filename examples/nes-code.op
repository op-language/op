//! NES Game Code
//!
//! Inline macros and functions for the NES demo game.

use nes_std::*;

// --- inline macros ---------------------------------------------------------

inline fn assign(dest, value) {
    lda value
    sta dest
}

inline fn assign_16i(dest, value) {
    lda #lo!(value)
    sta dest + 0
    lda #hi!(value)
    sta dest + 1
}

inline fn vram_set_address_i(addr) {
    lda PPU::STATUS
    lda #hi!(addr)
    sta PPU::ADDRESS
    lda #lo!(addr)
    sta PPU::ADDRESS
}

inline fn vram_clear_address() {
    lda 0
    sta PPU::ADDRESS
    sta PPU::ADDRESS
}

inline fn vram_write(value) {
    lda value
    sta PPU::IO
}

inline fn vram_write_a() {
    sta PPU::IO
}

inline fn turn_video_on() {
    assign(PPU::CNT1, CR_BACKVISIBLE | CR_BACKNOCLIP)
}

inline fn turn_video_off() {
    assign(PPU::CNT1, 0)
}

inline fn wait_for(amount) {
    ldx amount
    wait_for_func()
}

inline fn vram_write_string(addr, str) {
    vram_set_address_i(addr)
    assign_16i(pstr, str)
    vram_write_string_loop()
}

// --- functions -------------------------------------------------------------

fn disable_interrupts() {
    sei
}

fn reset_stack() {
    ldx 0xFF
    txs
}

fn system_initialize() {
    disable_interrupts()
    reset_stack()
    lda 0
    sta PPU::CNT0
    sta PPU::CNT1
    sta PPU::BG_SCROLL
    sta PPU::BG_SCROLL
    vram_clear_address()
}

fn vram_init() {
    vram_set_address_i(PAL_ADDRESS)
    vram_write(0x30)
    vram_write(0x21)
    vram_write(0x22)
    vram_write(0x0F)

    vram_set_address_i(NAME_TABLE_0_ADDRESS)
    lda 0
    ldy 8
    do {
        ldx 128
        do {
            vram_write_a()
            dex
        } while (not zero)
        dey
    } while (not zero)
}

fn vram_write_string_loop() {
    ldy 0
    loop {
        lda (pstr), y
        if (zero) {
            vram_clear_address()
            return
        }
        vram_write_a()
        iny
    }
}

fn pal_animate() {
    vram_set_address_i(PAL_ADDRESS)
    lda palcol
    clc
    adc 0x10
    sta palcol
    and 0x40
    php
    lda palcol
    plp
    if (set) {
        eor 0x30
    }
    and 0x3F
    vram_write_a()
    vram_clear_address()
}

fn wait_for_func() {
    do {
        vblank_wait_full()
        dex
    } while (not zero)
}

fn vblank_wait_full() {
    vblank_wait()
    unvblank_wait()
}

fn vblank_wait() {
    do {
        lda PPU::STATUS
    } while (is plus)
}

fn unvblank_wait() {
    do {
        lda PPU::STATUS
    } while (is minus)
}

// --- the main entry point --------------------------------------------------

noreturn fn main() {
    system_initialize()
    vram_init()
    turn_video_off()
    vram_write_string(NAME_TABLE_0_ADDRESS + 0x40, str_hello)
    vram_clear_address()
    assign(palcol, COLOUR::YELLOW)
    turn_video_on()

    loop {
        wait_for(6)
        pal_animate()
    }
}

fn nmi_handler() {
}

fn irq_handler() {
}

// --- string data -----------------------------------------------------------

str_hello: [u8] = "Hello, NES!";